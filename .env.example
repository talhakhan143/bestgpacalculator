# ----- Required -----
# Turso (libSQL) blog database
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Admin auth (used by /admin login + JWT signing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# ----- Analytics -----
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Required for analytics tracking; layout.tsx skips the tag when unset.
NEXT_PUBLIC_GA_ID=

# ----- IndexNow (Bing/Yandex fast indexing) -----
# Optional overrides; src/lib/indexnow.ts has working defaults.
INDEXNOW_KEY=
INDEXNOW_HOST=bestgpacalculator.online

# ----- Vercel Blob (image upload persistence) -----
# Auto-injected when a Blob store is linked to the Vercel project.
# Falls back to public/uploads/ on local dev when missing.
BLOB_READ_WRITE_TOKEN=

# ----- AI image generation (optional) -----
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
